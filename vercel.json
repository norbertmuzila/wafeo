{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/**",
          "server/**",
          "lib/**"
        ],
        "maxDuration": 60
      }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "style.css",
      "use": "@vercel/static"
    },
    {
      "src": "app.js",
      "use": "@vercel/static"
    },
    {
      "src": "privacy.html",
      "use": "@vercel/static"
    },
    {
      "src": "eo.js",
      "use": "@vercel/static"
    },
    {
      "src": "pages.js",
      "use": "@vercel/static"
    },
    {
      "src": "atlas.js",
      "use": "@vercel/static"
    },
    {
      "src": "report.js",
      "use": "@vercel/static"
    },
    {
      "src": "landing.js",
      "use": "@vercel/static"
    },
    {
      "src": "landing.css",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
