# WAFEO environment variables. Copy to .env for local use; set the same
# names in Vercel → Project → Settings → Environment Variables.

# Required in production: long random string that signs session tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Firestore (users, reports, activity). Leave empty to use data/*.json.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Google OAuth client ID(s), comma-separated. Defaults to the WAFEO client.
GOOGLE_CLIENT_ID=

# Google emails made admin whenever they sign in with Google (comma-separated).
ADMIN_EMAILS=

# Role for new sign-ups.
DEFAULT_ROLE=researcher

# NASA Earthdata token (https://urs.earthdata.nasa.gov → Profile → Generate Token):
# ECOSTRESS, SMAP, GRACE-FO and SWOT.
EARTHDATA_TOKEN=

# iSDAsoil account (https://www.isda-africa.com/isdasoil/): 30 m soil nutrients.
ISDA_USERNAME=
ISDA_PASSWORD=

# AI assistant (free key at https://console.groq.com).
GROQ_API_KEY=
# Optional: preferred model; falls back to openai/gpt-oss-120b, then -20b.
GROQ_MODEL=

# Local port (Vercel ignores this).
PORT=8080
